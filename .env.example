# Absolute path to the folder that holds hr.db, uploaded media and backups.
# Production (z.com): /home/<cpanel-user>/hr-data
DATA_DIR=

# Long random string (e.g. `openssl rand -hex 32`). Changing it logs everyone out.
PAYLOAD_SECRET=

# Public URL of the site, no trailing slash (e.g. https://hr.example.com)
SERVER_URL=http://localhost:4321

# SMTP for password resets and registration notices (leave SMTP_HOST empty to disable email)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=HR System

# Development/testing only: write emails to DATA_DIR/outbox.jsonl instead of sending (ignored in production)
HR_EMAIL_CAPTURE=

# Dev only: port of the Next.js (Payload admin/API) dev server that Astro proxies to
CMS_DEV_PORT=3001

# Set to false only if the host's home directory is on a network filesystem (check-host.sh tells you)
HR_SQLITE_WAL=true

# Days of nightly backups to keep in DATA_DIR/backups
BACKUP_KEEP=14
