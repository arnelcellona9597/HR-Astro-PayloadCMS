---
interface Props {
  label: string
  value: number | string
  note?: string
  href?: string
  tone?: 'neutral' | 'success' | 'warning' | 'danger' | 'primary'
}
const { label, value, note, href, tone = 'neutral' } = Astro.props
const Tag = href ? 'a' : 'div'
const dot = { neutral: 'bg-muted', success: 'bg-success', warning: 'bg-warning', danger: 'bg-danger', primary: 'bg-primary' }[tone]
---
<Tag href={href} class:list={['card block p-4', href && 'transition-colors hover:border-primary-ink']}>
  <p class="flex items-center gap-2 text-xs font-medium text-muted">
    <span class:list={['inline-block size-2 rounded-full', dot]} aria-hidden="true"></span>{label}
  </p>
  <p class="mt-2 text-3xl font-semibold tracking-tight">{typeof value === 'number' ? value.toLocaleString() : value}</p>
  {note && <p class="mt-1 text-xs text-muted">{note}</p>}
</Tag>
