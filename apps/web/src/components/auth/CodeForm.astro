---
// The 6-digit email code step shared by sign-in and registration.
interface Props {
  maskedEmail: string
  resendAvailableAt: string
  sendsLeft: number
  error?: string
  info?: string
  cancelHref: string
}
const { maskedEmail, resendAvailableAt, sendsLeft, error, info, cancelHref } = Astro.props
---
{error && <p class="mb-4 rounded-lg bg-danger-soft px-3 py-2 text-sm text-danger" role="alert">{error}</p>}
{info && <p class="mb-4 rounded-lg bg-success-soft px-3 py-2 text-sm text-success" role="status">{info}</p>}
<p class="mb-4 text-sm text-fg-2">We sent a 6-digit code to <strong class="text-fg">{maskedEmail}</strong>. It expires in 10 minutes.</p>
<form method="post" class="space-y-4">
  <input type="hidden" name="action" value="verify" />
  <div>
    <label class="label" for="code">Verification code</label>
    <input
      class="input text-center font-mono text-2xl tracking-[0.5em]"
      id="code"
      name="code"
      inputmode="numeric"
      autocomplete="one-time-code"
      pattern="[0-9]{6}"
      maxlength="6"
      required
      autofocus
    />
  </div>
  <button class="btn-primary w-full">Verify</button>
</form>
<div class="mt-4 flex items-center justify-between text-sm">
  <form method="post">
    <input type="hidden" name="action" value="resend" />
    <button class="text-primary-ink hover:underline disabled:text-muted disabled:no-underline" id="resend" data-at={resendAvailableAt} disabled={sendsLeft <= 0}>
      Send a new code
    </button>
  </form>
  <form method="post">
    <input type="hidden" name="action" value="cancel" />
    <button class="text-muted hover:text-fg">{cancelHref === '/register' ? 'Start over' : 'Use another account'}</button>
  </form>
</div>
<p class="mt-3 text-xs text-muted">Didn't get it? Check your spam folder. You can request a new code every minute.</p>

<script>
  const btn = document.getElementById('resend') as HTMLButtonElement | null
  if (btn && !btn.disabled) {
    const at = Date.parse(btn.dataset.at!)
    const label = btn.textContent
    const tick = () => {
      const s = Math.ceil((at - Date.now()) / 1000)
      if (s > 0) {
        btn.disabled = true
        btn.textContent = `Send a new code (${s}s)`
        setTimeout(tick, 1000)
      } else {
        btn.disabled = false
        btn.textContent = label
      }
    }
    tick()
  }
  const input = document.getElementById('code') as HTMLInputElement
  input.addEventListener('input', () => {
    input.value = input.value.replace(/\D/g, '').slice(0, 6)
    if (input.value.length === 6) input.form!.requestSubmit()
  })
</script>
