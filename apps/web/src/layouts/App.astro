---
import Icon from '../components/Icon.astro'
import Sidebar from '../components/shell/Sidebar.astro'
import Topbar from '../components/shell/Topbar.astro'
import { takeFlash } from '../lib/flash'
import { navGroups, sectionFor } from '../lib/nav'
import Base from './Base.astro'

interface Props {
  title: string
  /** Optional heading shown above the page (defaults to title). */
  heading?: string
  description?: string
  back?: { href: string; label: string }
}
const { title, heading = title, description, back } = Astro.props
const { user, settings, sessionExpiresAt, unreadNotifications = 0, mailWarning } = Astro.locals
const sessionEnds = sessionExpiresAt
  ? new Date(sessionExpiresAt).toLocaleTimeString('en-PH', { timeZone: 'Asia/Manila', hour: 'numeric', minute: '2-digit' })
  : null
const role = user?.role
const isSystemAdmin = role === 'system-admin'
const flash = takeFlash(Astro.cookies)
const denied = Astro.url.searchParams.get('denied') === '1'

const path = Astro.url.pathname
const groups = navGroups(role)
const logo = settings?.logo && typeof settings.logo === 'object' ? settings.logo : null
const company = settings?.companyName ?? 'HR Management System'

// Layout preferences: per-device cookies (like the theme), rendered server-side so nothing jumps.
const prefs = {
  collapsed: Astro.cookies.get('hr-sidebar')?.value === 'collapsed',
  right: Astro.cookies.get('hr-sidebar-side')?.value === 'right',
  compact: Astro.cookies.get('hr-header')?.value === 'compact',
}

// Breadcrumbs: Home › section (from the navigation) › this page.
const section = sectionFor(path, groups)
const crumbs: { href?: string; label: string }[] = [{ href: '/', label: 'Home' }]
if (path === '/') crumbs.length = 0
if (section && section.href !== '/' && section.href !== path) crumbs.push({ href: section.href, label: section.label })
crumbs.push({ label: path === '/' ? 'Dashboard' : section?.href === path ? section.label : title })
---
<Base title={title}>
  <a href="#content" class="sr-only z-[70] rounded-lg bg-surface px-4 py-2 text-sm font-medium shadow-pop focus:not-sr-only focus:fixed focus:left-4 focus:top-4">Skip to content</a>
  <div
    id="shell"
    data-sidebar={prefs.collapsed ? 'collapsed' : 'expanded'}
    data-side={prefs.right ? 'right' : 'left'}
    data-header={prefs.compact ? 'compact' : 'full'}
  >
    <Sidebar
      groups={groups}
      path={path}
      company={company}
      logoId={logo?.id}
      sessionEnds={sessionEnds}
      sessionExpiresAt={sessionExpiresAt}
      showPayloadAdmin={Boolean(role)}
    />

    <div class="flex min-w-0 flex-1 flex-col">
      <Topbar crumbs={crumbs} unread={unreadNotifications} user={{ name: user?.name ?? '', email: user?.email ?? '', role }} prefs={prefs} />

      <main id="content" tabindex="-1" class="mx-auto w-full max-w-[1440px] flex-1 px-4 py-6 outline-none sm:px-6 lg:px-8 lg:py-8">
        {
          back && (
            <a href={back.href} class="group mb-3 inline-flex items-center gap-1.5 text-sm text-muted transition-colors hover:text-fg">
              <Icon name="arrowLeft" class="size-4 transition-transform group-hover:-translate-x-0.5" /> {back.label}
            </a>
          )
        }
        <div class="mb-6 flex flex-wrap items-end justify-between gap-4 lg:mb-8">
          <div class="min-w-0">
            <h1 class="text-2xl font-semibold tracking-tight text-fg sm:text-[1.75rem] sm:leading-9">{heading}</h1>
            {description && <p class="mt-1.5 max-w-3xl text-sm text-muted">{description}</p>}
          </div>
          <div class="flex flex-wrap items-center gap-2"><slot name="actions" /></div>
        </div>

        {
          mailWarning && (
            <div class="mb-4 flex items-start gap-3 rounded-xl border border-danger/30 bg-danger-soft px-4 py-3 text-sm text-danger" role="alert">
              <Icon name="alert" class="mt-0.5 size-4 shrink-0" />
              <span>{mailWarning} {isSystemAdmin && <a class="font-medium underline underline-offset-2" href="/settings/email-server">Open email server settings</a>}</span>
            </div>
          )
        }
        {
          denied && (
            <div class="mb-4 flex items-start gap-3 rounded-xl border border-warning/30 bg-warning-soft px-4 py-3 text-sm text-warning" role="alert">
              <Icon name="alert" class="mt-0.5 size-4 shrink-0" /> You don't have permission to open that page.
            </div>
          )
        }
        {
          flash && (
            <div
              class:list={[
                'mb-4 flex items-start gap-3 rounded-xl border px-4 py-3 text-sm',
                flash.type === 'success' && 'border-success/25 bg-success-soft text-success',
                flash.type === 'error' && 'border-danger/30 bg-danger-soft text-danger',
                flash.type === 'info' && 'border-primary-ink/20 bg-primary-soft text-primary-ink',
              ]}
              role={flash.type === 'error' ? 'alert' : 'status'}
            >
              <Icon name={flash.type === 'success' ? 'checkCircle' : flash.type === 'error' ? 'alert' : 'info'} class="mt-0.5 size-4 shrink-0" />
              <span>{flash.message}</span>
            </div>
          )
        }
        <slot />
      </main>
    </div>
  </div>

  <script>
    const root = document.documentElement
    const shell = document.getElementById('shell')!
    const sidebar = document.getElementById('sidebar')!
    const backdrop = document.getElementById('sidebar-backdrop')!
    const desktop = matchMedia('(min-width: 64rem)')
    const setCookie = (name: string, value: string) => (document.cookie = `${name}=${value}; path=/; max-age=31536000; samesite=lax`)

    // ---- Mobile drawer: Esc / backdrop / close button, focus kept inside while open ----
    const opener = document.querySelector<HTMLButtonElement>('[data-sidebar-open]')
    const focusables = () => [...sidebar.querySelectorAll<HTMLElement>('a[href], button:not([disabled])')].filter((el) => el.offsetParent !== null)
    const setOpen = (open: boolean) => {
      sidebar.dataset.open = String(open)
      backdrop.dataset.open = String(open)
      opener?.setAttribute('aria-expanded', String(open))
      document.body.style.overflow = open ? 'hidden' : ''
      if (open) requestAnimationFrame(() => focusables()[0]?.focus())
      else if (sidebar.contains(document.activeElement)) opener?.focus()
    }
    opener?.addEventListener('click', () => setOpen(true))
    backdrop.addEventListener('click', () => setOpen(false))
    sidebar.querySelector('[data-sidebar-close]')?.addEventListener('click', () => setOpen(false))
    sidebar.addEventListener('keydown', (e) => {
      if (sidebar.dataset.open !== 'true') return
      if (e.key === 'Escape') setOpen(false)
      if (e.key !== 'Tab') return
      const items = focusables()
      const first = items[0]
      const last = items[items.length - 1]
      if (e.shiftKey && document.activeElement === first) (e.preventDefault(), last?.focus())
      else if (!e.shiftKey && document.activeElement === last) (e.preventDefault(), first?.focus())
    })
    desktop.addEventListener('change', () => sidebar.dataset.open === 'true' && setOpen(false))

    // ---- Preferences (sidebar collapsed / side, compact header, theme) ----
    const prefState = () => ({
      collapsed: shell.dataset.sidebar === 'collapsed',
      right: shell.dataset.side === 'right',
      compact: shell.dataset.header === 'compact',
      theme: root.dataset.theme === 'dark',
    })
    const syncPrefs = () => {
      const s = prefState()
      document.querySelectorAll<HTMLElement>('[data-pref]').forEach((el) => {
        el.setAttribute('aria-checked', String(s[el.dataset.pref as keyof typeof s]))
      })
      document.querySelectorAll<HTMLElement>('[data-sidebar-toggle]').forEach((el) => {
        el.setAttribute('aria-expanded', String(!s.collapsed))
        const label = el.querySelector('[data-toggle-label]')
        if (label) label.textContent = s.collapsed ? 'Expand sidebar' : 'Collapse sidebar'
      })
      document.querySelector('[data-header-toggle]')?.setAttribute('aria-pressed', String(s.compact))
    }
    const setPref = (pref: string, on: boolean) => {
      if (pref === 'collapsed') (shell.dataset.sidebar = on ? 'collapsed' : 'expanded'), setCookie('hr-sidebar', shell.dataset.sidebar)
      if (pref === 'right') (shell.dataset.side = on ? 'right' : 'left'), setCookie('hr-sidebar-side', shell.dataset.side)
      if (pref === 'compact') (shell.dataset.header = on ? 'compact' : 'full'), setCookie('hr-header', shell.dataset.header)
      if (pref === 'theme') {
        root.dataset.theme = on ? 'dark' : 'light'
        setCookie('hr-theme', root.dataset.theme)
        window.dispatchEvent(new CustomEvent('hr:theme'))
      }
      hideTip()
      syncPrefs()
    }
    document.querySelectorAll<HTMLElement>('[data-sidebar-toggle]').forEach((el) =>
      el.addEventListener('click', () => setPref('collapsed', !prefState().collapsed)),
    )
    document.querySelector('[data-header-toggle]')?.addEventListener('click', () => setPref('compact', !prefState().compact))
    document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => setPref('theme', !prefState().theme))
    document.querySelectorAll<HTMLElement>('[data-pref]').forEach((el) =>
      el.addEventListener('click', () => setPref(el.dataset.pref!, el.getAttribute('aria-checked') !== 'true')),
    )
    syncPrefs()

    // ---- Tooltips for the collapsed sidebar (one floating element, placed beside the icon) ----
    const tip = document.getElementById('nav-tip')!
    function hideTip() {
      tip.dataset.show = 'false'
    }
    const showTip = (el: HTMLElement) => {
      if (!desktop.matches || shell.dataset.sidebar !== 'collapsed' || !el.dataset.tip) return
      tip.textContent = el.dataset.tip
      const r = el.getBoundingClientRect()
      const right = shell.dataset.side === 'right'
      tip.style.top = `${r.top + r.height / 2 - tip.offsetHeight / 2}px`
      tip.style.left = right ? `${r.left - tip.offsetWidth - 10}px` : `${r.right + 10}px`
      tip.dataset.show = 'true'
    }
    sidebar.querySelectorAll<HTMLElement>('[data-tip]').forEach((el) => {
      el.addEventListener('mouseenter', () => showTip(el))
      el.addEventListener('focus', () => showTip(el))
      el.addEventListener('mouseleave', hideTip)
      el.addEventListener('blur', hideTip)
    })
    sidebar.querySelector('nav')?.addEventListener('scroll', hideTip, { passive: true })

    // ---- Account menu (menu button pattern) ----
    const menuBtn = document.getElementById('user-menu-button')
    const menu = document.getElementById('user-menu')
    if (menuBtn && menu) {
      const items = () => [...menu.querySelectorAll<HTMLElement>('[role^="menuitem"]')].filter((el) => el.offsetParent !== null)
      let closeTimer: number | undefined
      const isOpen = () => menuBtn.getAttribute('aria-expanded') === 'true'
      const open = (focus: 'first' | 'last' | null = 'first') => {
        clearTimeout(closeTimer)
        syncPrefs()
        menu.hidden = false
        menuBtn.setAttribute('aria-expanded', 'true')
        requestAnimationFrame(() => {
          menu.dataset.open = 'true'
          const list = items()
          if (focus) (focus === 'first' ? list[0] : list[list.length - 1])?.focus()
        })
      }
      const close = (returnFocus = true) => {
        if (!isOpen()) return
        menuBtn.setAttribute('aria-expanded', 'false')
        menu.dataset.open = 'false'
        closeTimer = window.setTimeout(() => (menu.hidden = true), 130)
        if (returnFocus) menuBtn.focus()
      }
      menuBtn.addEventListener('click', () => (isOpen() ? close() : open(null)))
      menuBtn.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowDown' || e.key === 'Enter' || e.key === ' ') (e.preventDefault(), open('first'))
        if (e.key === 'ArrowUp') (e.preventDefault(), open('last'))
      })
      menu.addEventListener('keydown', (e) => {
        const list = items()
        const i = list.indexOf(document.activeElement as HTMLElement)
        const move = (n: number) => (e.preventDefault(), list[(n + list.length) % list.length]?.focus())
        if (e.key === 'ArrowDown') move(i + 1)
        else if (e.key === 'ArrowUp') move(i - 1)
        else if (e.key === 'Home') move(0)
        else if (e.key === 'End') move(list.length - 1)
        else if (e.key === 'Escape') (e.preventDefault(), close())
        else if (e.key === 'Tab') close(false)
      })
      document.addEventListener('click', (e) => {
        if (isOpen() && !menu.contains(e.target as Node) && !menuBtn.contains(e.target as Node)) close(false)
      })
    }

    // ---- "/" focuses the employee search ----
    document.addEventListener('keydown', (e) => {
      const t = e.target as HTMLElement
      if (e.key !== '/' || e.ctrlKey || e.metaKey || e.altKey || t.closest('input, textarea, select, [contenteditable="true"]')) return
      const input = document.getElementById('topbar-q') as HTMLInputElement | null
      if (input && input.offsetParent !== null) (e.preventDefault(), input.focus(), input.select())
    })

    // Sessions end 12 hours after sign-in: send the user to the sign-in page when that happens.
    const expiresEl = document.querySelector<HTMLElement>('[data-session-expires]')
    if (expiresEl) {
      const expires = Number(expiresEl.dataset.sessionExpires)
      const check = () => {
        if (Date.now() >= expires) location.href = '/login?notice=expired'
      }
      setInterval(check, 30_000)
      document.addEventListener('visibilitychange', check)
    }

    // Warn before leaving a form with unsaved changes.
    document.querySelectorAll<HTMLFormElement>('form[data-dirty-guard]').forEach((form) => {
      let dirty = false
      form.addEventListener('input', () => (dirty = true))
      form.addEventListener('submit', () => (dirty = false))
      window.addEventListener('beforeunload', (e) => {
        if (dirty) e.preventDefault()
      })
    })

    // Confirmation prompts for destructive actions.
    document.querySelectorAll<HTMLFormElement>('form[data-confirm]').forEach((form) => {
      form.addEventListener('submit', (e) => {
        if (!confirm(form.dataset.confirm)) e.preventDefault()
      })
    })
  </script>
</Base>
