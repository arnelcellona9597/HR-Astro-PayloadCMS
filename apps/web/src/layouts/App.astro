---
import { ROLE_LABELS } from '@hr/shared/enums'

import Icon from '../components/Icon.astro'
import { takeFlash } from '../lib/flash'
import Base from './Base.astro'

interface Props {
  title: string
  /** Optional heading shown above the page (defaults to title). */
  heading?: string
  description?: string
  back?: { href: string; label: string }
}
const { title, heading = title, description, back } = Astro.props
const { user, settings, payload } = Astro.locals
const role = user?.role
const isAdmin = role === 'super-admin' || role === 'hr-admin'
const flash = takeFlash(Astro.cookies)
const denied = Astro.url.searchParams.get('denied') === '1'

let pendingUsers = 0
if (role === 'super-admin') {
  pendingUsers = (await payload.count({ collection: 'users', where: { status: { equals: 'pending' } }, overrideAccess: true }))
    .totalDocs
}

type NavItem = { href: string; label: string; icon: string; show?: boolean; badge?: number }
const main: NavItem[] = [
  { href: '/', label: 'Dashboard', icon: 'dashboard' },
  { href: '/employees', label: 'Employees', icon: 'users' },
  { href: '/onboarding', label: 'Onboarding Tracker', icon: 'clipboard' },
  { href: '/leave', label: 'Wellness Leave', icon: 'calendar' },
  { href: '/branches', label: 'Branches', icon: 'building' },
  { href: '/requirements', label: 'Annual Requirements', icon: 'file' },
  { href: '/data', label: 'Import / Export', icon: 'sheet' },
]
const admin: NavItem[] = [
  { href: '/users', label: 'HR Users', icon: 'shield', show: role === 'super-admin', badge: pendingUsers },
  { href: '/settings', label: 'Branding & Theme', icon: 'settings', show: role === 'super-admin' },
  { href: '/audit', label: 'Audit Log', icon: 'history', show: isAdmin },
].filter((i) => i.show)

const path = Astro.url.pathname
const isActive = (href: string) => (href === '/' ? path === '/' : path === href || path.startsWith(`${href}/`))
const logo = settings?.logo && typeof settings.logo === 'object' ? settings.logo : null
const company = settings?.companyName ?? 'HR Management System'
---
<Base title={title}>
  <div class="lg:flex">
    <!-- Sidebar -->
    <aside
      id="sidebar"
      class="fixed inset-y-0 left-0 z-40 flex w-64 -translate-x-full flex-col border-r border-line bg-surface transition-transform lg:sticky lg:top-0 lg:h-dvh lg:translate-x-0"
      data-open="false"
    >
      <a href="/" class="flex items-center gap-3 border-b border-line px-4 py-4">
        {
          logo ? (
            <img src={`/files/${logo.id}`} alt="" class="size-9 shrink-0 rounded-lg object-contain" />
          ) : (
            <span class="flex size-9 shrink-0 items-center justify-center rounded-lg bg-primary text-sm font-bold text-on-primary">
              {company.slice(0, 2).toUpperCase()}
            </span>
          )
        }
        <span class="min-w-0">
          <span class="block truncate text-sm font-semibold">{company}</span>
          <span class="block truncate text-xs text-muted">Human Resource Management</span>
        </span>
      </a>
      <nav class="flex-1 overflow-y-auto px-3 py-4" aria-label="Main">
        <ul class="space-y-1">
          {
            main.map((item) => (
              <li>
                <a
                  href={item.href}
                  class:list={[
                    'flex items-center gap-3 rounded-lg px-3 py-2 text-sm font-medium transition-colors',
                    isActive(item.href) ? 'bg-primary-soft text-primary-ink' : 'text-fg-2 hover:bg-surface-2 hover:text-fg',
                  ]}
                  aria-current={isActive(item.href) ? 'page' : undefined}
                >
                  <Icon name={item.icon as never} class="size-4 shrink-0" />
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
        {
          admin.length > 0 && (
            <>
              <p class="mt-6 px-3 text-xs font-semibold uppercase tracking-wide text-muted">Administration</p>
              <ul class="mt-2 space-y-1">
                {admin.map((item) => (
                  <li>
                    <a
                      href={item.href}
                      class:list={[
                        'flex items-center gap-3 rounded-lg px-3 py-2 text-sm font-medium transition-colors',
                        isActive(item.href) ? 'bg-primary-soft text-primary-ink' : 'text-fg-2 hover:bg-surface-2 hover:text-fg',
                      ]}
                    >
                      <Icon name={item.icon as never} class="size-4 shrink-0" />
                      <span class="flex-1">{item.label}</span>
                      {item.badge ? <span class="badge-warning">{item.badge}</span> : null}
                    </a>
                  </li>
                ))}
                {isAdmin && (
                  <li>
                    <a
                      href="/admin"
                      class="flex items-center gap-3 rounded-lg px-3 py-2 text-sm font-medium text-fg-2 hover:bg-surface-2 hover:text-fg"
                    >
                      <Icon name="external" class="size-4 shrink-0" />
                      Payload Admin
                    </a>
                  </li>
                )}
              </ul>
            </>
          )
        }
      </nav>
      <div class="border-t border-line p-3">
        <a href="/profile" class="flex items-center gap-3 rounded-lg px-2 py-2 hover:bg-surface-2">
          <span class="flex size-8 items-center justify-center rounded-full bg-surface-2 text-xs font-semibold text-fg-2">
            {(user?.name ?? '?').split(' ').map((p) => p[0]).slice(0, 2).join('').toUpperCase()}
          </span>
          <span class="min-w-0 flex-1">
            <span class="block truncate text-sm font-medium">{user?.name}</span>
            <span class="block truncate text-xs text-muted">{role ? ROLE_LABELS[role] : ''}</span>
          </span>
        </a>
        <div class="mt-2 flex gap-2">
          <button type="button" class="btn-secondary btn-sm flex-1" data-theme-toggle>
            <Icon name="moon" class="size-3.5 dark:hidden" />
            <Icon name="sun" class="hidden size-3.5 dark:block" />
            <span class="dark:hidden">Dark mode</span><span class="hidden dark:inline">Light mode</span>
          </button>
          <form method="post" action="/logout">
            <button class="btn-secondary btn-sm" title="Sign out"><Icon name="logout" class="size-3.5" label="Sign out" /></button>
          </form>
        </div>
      </div>
    </aside>
    <div id="sidebar-backdrop" class="fixed inset-0 z-30 hidden bg-black/40 lg:hidden"></div>

    <!-- Main -->
    <div class="min-w-0 flex-1">
      <header class="sticky top-0 z-20 flex items-center gap-3 border-b border-line bg-surface/90 px-4 py-3 backdrop-blur lg:hidden">
        <button type="button" class="btn-ghost btn-sm" data-sidebar-open aria-controls="sidebar" aria-label="Open menu">
          <Icon name="menu" class="size-5" />
        </button>
        <span class="truncate text-sm font-semibold">{company}</span>
      </header>

      <main class="mx-auto w-full max-w-[1400px] px-4 py-6 sm:px-6 lg:px-8 lg:py-8">
        {
          back && (
            <a href={back.href} class="mb-3 inline-flex items-center gap-1 text-sm text-muted hover:text-fg">
              <Icon name="arrowLeft" class="size-4" /> {back.label}
            </a>
          )
        }
        <div class="mb-6 flex flex-wrap items-start justify-between gap-4">
          <div class="min-w-0">
            <h1 class="text-2xl font-semibold tracking-tight">{heading}</h1>
            {description && <p class="mt-1 max-w-3xl text-sm text-muted">{description}</p>}
          </div>
          <div class="flex flex-wrap items-center gap-2"><slot name="actions" /></div>
        </div>

        {
          denied && (
            <div class="mb-4 flex items-start gap-2 rounded-lg border border-line bg-warning-soft px-4 py-3 text-sm text-warning" role="alert">
              <Icon name="alert" class="mt-0.5 size-4 shrink-0" /> You don't have permission to open that page.
            </div>
          )
        }
        {
          flash && (
            <div
              class:list={[
                'mb-4 flex items-start gap-2 rounded-lg border border-line px-4 py-3 text-sm',
                flash.type === 'success' && 'bg-success-soft text-success',
                flash.type === 'error' && 'bg-danger-soft text-danger',
                flash.type === 'info' && 'bg-primary-soft text-primary-ink',
              ]}
              role={flash.type === 'error' ? 'alert' : 'status'}
            >
              <Icon name={flash.type === 'success' ? 'check' : flash.type === 'error' ? 'alert' : 'info'} class="mt-0.5 size-4 shrink-0" />
              <span>{flash.message}</span>
            </div>
          )
        }
        <slot />
      </main>
    </div>
  </div>

  <script>
    const sidebar = document.getElementById('sidebar')!
    const backdrop = document.getElementById('sidebar-backdrop')!
    const setOpen = (open: boolean) => {
      sidebar.classList.toggle('-translate-x-full', !open)
      backdrop.classList.toggle('hidden', !open)
    }
    document.querySelector('[data-sidebar-open]')?.addEventListener('click', () => setOpen(true))
    backdrop.addEventListener('click', () => setOpen(false))

    document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
      const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark'
      document.documentElement.dataset.theme = next
      document.cookie = `hr-theme=${next}; path=/; max-age=31536000; samesite=lax`
      window.dispatchEvent(new CustomEvent('hr:theme'))
    })

    // Warn before leaving a form with unsaved changes.
    document.querySelectorAll<HTMLFormElement>('form[data-dirty-guard]').forEach((form) => {
      let dirty = false
      form.addEventListener('input', () => (dirty = true))
      form.addEventListener('submit', () => (dirty = false))
      window.addEventListener('beforeunload', (e) => {
        if (dirty) e.preventDefault()
      })
    })

    // Confirmation prompts for destructive actions.
    document.querySelectorAll<HTMLFormElement>('form[data-confirm]').forEach((form) => {
      form.addEventListener('submit', (e) => {
        if (!confirm(form.dataset.confirm)) e.preventDefault()
      })
    })
  </script>
</Base>
