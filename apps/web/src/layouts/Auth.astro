---
import Base from './Base.astro'

interface Props {
  title: string
  subtitle?: string
}
const { title, subtitle } = Astro.props
const { settings } = Astro.locals
const logo = settings?.logo && typeof settings.logo === 'object' ? settings.logo : null
---
<Base title={title}>
  <main class="flex min-h-dvh items-center justify-center px-4 py-10">
    <div class="w-full max-w-md">
      <div class="mb-6 flex flex-col items-center text-center">
        {
          logo ? (
            <img src={`/files/${logo.id}`} alt="" class="mb-3 h-16 w-auto max-w-[200px] object-contain" />
          ) : (
            <div class="mb-3 flex size-14 items-center justify-center rounded-2xl bg-primary text-xl font-bold text-on-primary">
              {(settings?.companyName ?? 'HR').slice(0, 2).toUpperCase()}
            </div>
          )
        }
        <p class="text-sm font-semibold text-fg-2">{settings?.companyName}</p>
        {settings?.tagline && <p class="text-xs text-muted">{settings.tagline}</p>}
      </div>
      <div class="card p-6 shadow-sm sm:p-8">
        <h1 class="text-xl font-semibold">{title}</h1>
        {subtitle && <p class="mt-1 text-sm text-muted">{subtitle}</p>}
        <div class="mt-6"><slot /></div>
      </div>
      <div class="mt-6 text-center text-sm text-muted"><slot name="footer" /></div>
    </div>
  </main>
</Base>
