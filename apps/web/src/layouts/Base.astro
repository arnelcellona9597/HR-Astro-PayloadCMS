---
import { readableOn, resolvePalette } from '@hr/shared/colors'
import '../styles/global.css'

interface Props {
  title: string
}
const { title } = Astro.props
const { settings, theme } = Astro.locals
const palette = resolvePalette(settings?.palette)
const brandVars = [
  `--brand-primary:${palette.primary}`,
  `--brand-secondary:${palette.secondary}`,
  `--brand-accent:${palette.accent}`,
  `--brand-success:${palette.success}`,
  `--brand-warning:${palette.warning}`,
  `--brand-danger:${palette.danger}`,
  `--brand-on-primary:${readableOn(palette.primary)}`,
].join(';')
const logo = settings?.logo && typeof settings.logo === 'object' ? settings.logo : null
const company = settings?.companyName ?? 'HR Management System'
const explicitTheme = theme === 'light' || theme === 'dark' ? theme : undefined
---
<!doctype html>
<html lang="en" data-theme={explicitTheme} style={brandVars}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} · {company}</title>
    {logo ? <link rel="icon" href={`/files/${logo.id}`} /> : <link rel="icon" href="data:," />}
    {
      !explicitTheme && (
        <script is:inline>
          document.documentElement.dataset.theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'
        </script>
      )
    }
  </head>
  <body class="min-h-dvh antialiased">
    <slot />
  </body>
</html>
