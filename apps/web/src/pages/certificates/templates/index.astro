---
import { newBlock } from '@hr/shared/certificates'

import EmptyState from '../../../components/EmptyState.astro'
import Icon from '../../../components/Icon.astro'
import App from '../../../layouts/App.astro'
import { errorMessage } from '../../../lib/errors'
import { setFlash } from '../../../lib/flash'

const { payload, user } = Astro.locals

if (Astro.request.method === 'POST') {
  const fd = await Astro.request.formData()
  const action = String(fd.get('action'))
  const id = Number(fd.get('id')) || null
  try {
    if (action === 'create') {
      const name = String(fd.get('name') ?? '').trim()
      if (!name) throw new Error('Give the new template a name (its purpose).')
      const blocks = [newBlock('header'), newBlock('divider'), { ...newBlock('spacer'), size: 'lg' as const }, newBlock('title'), { ...newBlock('spacer'), size: 'lg' as const }, newBlock('paragraph'), { ...newBlock('spacer'), size: 'xl' as const }, newBlock('signatory')]
      const doc = await payload.create({ collection: 'certificate-templates', data: { name, prefix: 'COE', blocks, sortOrder: 100 } as never, user, overrideAccess: false })
      setFlash(Astro.cookies, { type: 'success', message: `Template “${doc.name}” created. Drag blocks to build it, then save.` })
      return Astro.redirect(`/certificates/templates/${doc.id}`)
    }
    if (id && action === 'duplicate') {
      const src = await payload.findByID({ collection: 'certificate-templates', id, depth: 0, user, overrideAccess: false })
      let name = `${src.name} (copy)`
      for (let n = 2; (await payload.count({ collection: 'certificate-templates', where: { name: { equals: name } }, overrideAccess: true })).totalDocs; n++) name = `${src.name} (copy ${n})`
      const doc = await payload.create({
        collection: 'certificate-templates',
        data: { name, description: src.description, prefix: src.prefix, paperSize: src.paperSize, font: src.font, margin: src.margin, blocks: src.blocks, sortOrder: (src.sortOrder ?? 100) + 1, active: true } as never,
        user,
        overrideAccess: false,
      })
      setFlash(Astro.cookies, { type: 'success', message: `Copied to “${doc.name}”.` })
      return Astro.redirect(`/certificates/templates/${doc.id}`)
    }
    if (id && action === 'toggle') {
      const src = await payload.findByID({ collection: 'certificate-templates', id, depth: 0, user, overrideAccess: false })
      await payload.update({ collection: 'certificate-templates', id, data: { active: !src.active }, user, overrideAccess: false })
      setFlash(Astro.cookies, { type: 'success', message: `“${src.name}” is now ${src.active ? 'inactive' : 'active'}.` })
    }
    if (id && action === 'delete') {
      const used = await payload.count({ collection: 'certificates', where: { template: { equals: id } }, overrideAccess: true })
      if (used.totalDocs) throw new Error('Certificates were issued from this template, so it is kept for the record. Make it inactive instead.')
      await payload.delete({ collection: 'certificate-templates', id, user, overrideAccess: false })
      setFlash(Astro.cookies, { type: 'success', message: 'Template deleted.' })
    }
  } catch (err) {
    const msg = err instanceof Error && /^(Give|Certificates were)/.test(err.message) ? err.message : errorMessage(err)
    setFlash(Astro.cookies, { type: 'error', message: msg })
  }
  return Astro.redirect('/certificates/templates')
}

const templates = await payload.find({ collection: 'certificate-templates', sort: ['sortOrder', 'name'], pagination: false, depth: 0, user, overrideAccess: false })
const counts = new Map(
  await Promise.all(templates.docs.map(async (t) => [t.id, (await payload.count({ collection: 'certificates', where: { template: { equals: t.id } }, overrideAccess: true })).totalDocs] as const)),
)
---
<App title="Certificate templates" heading="Certificate templates" back={{ href: '/certificates', label: 'Certificates' }} description="One template per purpose. Open a template to arrange its blocks by drag and drop.">
  <section class="card mb-6 p-5">
    <h2 class="font-semibold">New template</h2>
    <form method="post" class="mt-3 flex flex-wrap items-end gap-3">
      <input type="hidden" name="action" value="create" />
      <div class="min-w-64 flex-1">
        <label class="label" for="new-name">Purpose / template name</label>
        <input class="input" id="new-name" name="name" required maxlength="120" placeholder="e.g. Certificate of Employment – Travel Abroad" />
      </div>
      <button class="btn-primary"><Icon name="plus" /> Create and edit</button>
    </form>
    <p class="field-help">Tip: to start from an existing layout, use <strong>Duplicate</strong> on a template below.</p>
  </section>

  {
    templates.docs.length === 0 ? (
      <div class="card"><EmptyState title="No templates yet." text="Create one above." /></div>
    ) : (
      <ul class="grid gap-4 md:grid-cols-2 2xl:grid-cols-3">
        {templates.docs.map((t) => (
          <li class="card flex flex-col p-5">
            <div class="flex items-start justify-between gap-3">
              <h3 class="font-semibold leading-snug">
                <a href={`/certificates/templates/${t.id}`} class="hover:text-primary-ink hover:underline">{t.name}</a>
              </h3>
              <span class={t.active ? 'badge-success' : 'badge-neutral'}>{t.active ? 'Active' : 'Inactive'}</span>
            </div>
            {t.description && <p class="mt-1 text-sm text-muted">{t.description}</p>}
            <p class="mt-3 text-xs text-muted">
              {t.prefix}-YYYY-0001 · {t.paperSize} · {t.font === 'sans' ? 'Sans-serif' : 'Serif'} · {counts.get(t.id) ?? 0} issued
            </p>
            <div class="mt-4 flex flex-wrap gap-2 border-t border-line pt-4">
              <a class="btn-primary btn-sm" href={`/certificates/templates/${t.id}`}><Icon name="edit" class="size-3.5" /> Edit layout</a>
              <form method="post"><input type="hidden" name="id" value={t.id} /><input type="hidden" name="action" value="duplicate" /><button class="btn-secondary btn-sm"><Icon name="copy" class="size-3.5" /> Duplicate</button></form>
              <form method="post"><input type="hidden" name="id" value={t.id} /><input type="hidden" name="action" value="toggle" /><button class="btn-ghost btn-sm">{t.active ? 'Deactivate' : 'Activate'}</button></form>
              {!counts.get(t.id) && (
                <form method="post" data-confirm={`Delete the template “${t.name}”?`}>
                  <input type="hidden" name="id" value={t.id} />
                  <input type="hidden" name="action" value="delete" />
                  <button class="btn-ghost btn-sm text-danger"><Icon name="trash" class="size-3.5" /> Delete</button>
                </form>
              )}
            </div>
          </li>
        ))}
      </ul>
    )
  }
</App>
