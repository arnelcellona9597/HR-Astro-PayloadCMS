---
import Auth from '../layouts/Auth.astro'

let sent = false
const emailEnabled = Boolean(process.env.SMTP_HOST)
if (Astro.request.method === 'POST') {
  const fd = await Astro.request.formData()
  const email = String(fd.get('email') ?? '').trim().toLowerCase()
  if (email) {
    try {
      await Astro.locals.payload.forgotPassword({ collection: 'users', data: { email } })
    } catch (err) {
      // Never reveal whether an address exists.
      console.warn('forgot-password:', (err as Error).message)
    }
  }
  sent = true
}
---
<Auth title="Reset your password" subtitle="We'll email you a link to set a new password.">
  {
    sent ? (
      <p class="rounded-lg bg-success-soft px-3 py-2 text-sm text-success" role="status">
        If that email belongs to an account, a reset link is on its way. The link is valid for 1 hour.
      </p>
    ) : (
      <form method="post" class="space-y-4">
        {!emailEnabled && (
          <p class="rounded-lg bg-warning-soft px-3 py-2 text-sm text-warning">
            Email sending is not configured on this server. Ask a System Admin to reset your password.
          </p>
        )}
        <div>
          <label class="label" for="email">Email</label>
          <input class="input" id="email" name="email" type="email" required autocomplete="username" />
        </div>
        <button class="btn-primary w-full">Send reset link</button>
      </form>
    )
  }
  <Fragment slot="footer"><a href="/login" class="font-medium text-primary-ink hover:underline">Back to sign in</a></Fragment>
</Auth>
