---
import { startLogin } from '@hr/cms/server/twofactor'

import Auth from '../layouts/Auth.astro'
import { clientIp, safeNext, setChallengeCookie } from '../lib/auth'

let error = ''
let email = ''
const next = safeNext(Astro.url.searchParams.get('next'))
const notice = Astro.url.searchParams.get('notice')

if (Astro.request.method === 'POST') {
  const fd = await Astro.request.formData()
  email = String(fd.get('email') ?? '').trim().toLowerCase()
  const password = String(fd.get('password') ?? '')
  if (!email || !password) {
    error = 'Enter your email and password.'
  } else {
    try {
      // Step 1: password. Step 2 (/login/verify): the code emailed to the user.
      const res = await startLogin(Astro.locals.payload, email, password, clientIp(Astro.request))
      setChallengeCookie(Astro.cookies, res.challenge, safeNext(String(fd.get('next') ?? '')))
      return Astro.redirect('/login/verify')
    } catch (err) {
      const e = err as { message?: string; name?: string }
      if (e.name === 'LockedAuth') error = 'Too many failed attempts. This account is locked for 15 minutes.'
      else if (/approval|disabled/i.test(e.message ?? '')) error = e.message!
      else error = 'Incorrect email or password.'
    }
  }
  Astro.response.status = 400
}
---
<Auth title="Sign in" subtitle="HR staff access only.">
  {notice === 'expired' && (
    <p class="mb-4 rounded-lg bg-warning-soft px-3 py-2 text-sm text-warning" role="status">
      Your session ended (sessions last 12 hours). Please sign in again.
    </p>
  )}
  {notice === 'restart' && (
    <p class="mb-4 rounded-lg bg-warning-soft px-3 py-2 text-sm text-warning" role="status">
      The verification code expired or was entered wrong too many times. Please sign in again.
    </p>
  )}
  {notice === 'password-set' && (
    <p class="mb-4 rounded-lg bg-success-soft px-3 py-2 text-sm text-success" role="status">Password saved. Sign in with your new password.</p>
  )}
  {notice === 'no-signup' && (
    <p class="mb-4 rounded-lg bg-primary-soft px-3 py-2 text-sm text-primary-ink" role="status">Accounts are created by a System Admin. Ask yours for an invitation.</p>
  )}
  {notice === 'password' && (
    <p class="mb-4 rounded-lg bg-success-soft px-3 py-2 text-sm text-success" role="status">Password changed. Please sign in again.</p>
  )}
  {notice === 'reset' && (
    <p class="mb-4 rounded-lg bg-success-soft px-3 py-2 text-sm text-success" role="status">Password updated. Sign in with your new password.</p>
  )}
  {error && <p class="mb-4 rounded-lg bg-danger-soft px-3 py-2 text-sm text-danger" role="alert">{error}</p>}
  <form method="post" class="space-y-4">
    <input type="hidden" name="next" value={next} />
    <div>
      <label class="label" for="email">Email</label>
      <input class="input" id="email" name="email" type="email" autocomplete="username" required value={email} autofocus />
    </div>
    <div>
      <div class="flex items-center justify-between">
        <label class="label" for="password">Password</label>
        <a href="/forgot-password" class="mb-1 text-xs text-primary-ink hover:underline">Forgot password?</a>
      </div>
      <input class="input" id="password" name="password" type="password" autocomplete="current-password" required />
    </div>
    <button class="btn-primary w-full">Sign in</button>
  </form>
  <Fragment slot="footer">New HR staff? Ask your System Admin to create your account.</Fragment>
</Auth>
