---
import { drainQueue, retryFailed } from '@hr/cms/server/mailer'
import type { Where } from 'payload'

import Icon from '../../components/Icon.astro'
import Pagination from '../../components/Pagination.astro'
import App from '../../layouts/App.astro'
import { setFlash } from '../../lib/flash'

const { payload, user } = Astro.locals
const id = Number(Astro.params.id)
const msg = await payload.findByID({ collection: 'messages', id, depth: 1, user, overrideAccess: false, disableErrors: true })
if (!msg) return new Response(null, { status: 404 })

if (Astro.request.method === 'POST') {
  const fd = await Astro.request.formData()
  if (fd.get('action') === 'retry') {
    const n = await retryFailed(payload, id)
    setFlash(Astro.cookies, { type: 'success', message: `${n} failed email(s) put back in the queue.` })
  } else {
    const r = await drainQueue(payload)
    setFlash(Astro.cookies, { type: 'info', message: `Sent ${r.sent} email(s) now. ${r.remaining > 0 ? `${r.remaining} still waiting (hourly limit or retry delay).` : ''}` })
  }
  return Astro.redirect(`/messages/${id}`)
}

const status = Astro.url.searchParams.get('status') ?? ''
const page = Math.max(1, Number(Astro.url.searchParams.get('page')) || 1)
const where: Where = { and: [{ message: { equals: id } }, ...(status ? [{ status: { equals: status } }] : [])] }
const recipients = await payload.find({ collection: 'message-recipients', where, sort: 'id', page, limit: 50, depth: 0, user, overrideAccess: false })
const tone: Record<string, string> = { sent: 'badge-success', failed: 'badge-danger', skipped: 'badge-warning', queued: 'badge-neutral', sending: 'badge-primary' }
const attachments = (msg.attachments ?? []).filter((a) => typeof a === 'object' && a) as { id: number; filename?: string | null }[]
const pending = msg.status === 'queued' || msg.status === 'sending'
---
<App title={msg.subject} heading={msg.subject} back={{ href: '/messages', label: 'Messages' }}>
  <Fragment slot="actions">
    {pending && <form method="post"><input type="hidden" name="action" value="process" /><button class="btn-secondary"><Icon name="send" /> Send queued now</button></form>}
    {(msg.failed ?? 0) > 0 && <form method="post"><input type="hidden" name="action" value="retry" /><button class="btn-primary">Retry {msg.failed} failed</button></form>}
  </Fragment>
  <div class="grid gap-6 xl:grid-cols-3">
    <section class="card space-y-3 p-5 text-sm xl:col-span-1">
      <dl class="grid grid-cols-3 gap-2">
        <dt class="text-muted">Status</dt><dd class="col-span-2"><span class={tone[msg.status === 'partial' ? 'skipped' : msg.status] ?? 'badge-neutral'}>{msg.status}</span></dd>
        <dt class="text-muted">Category</dt><dd class="col-span-2">{msg.category}{msg.automatic && ' (automatic)'}</dd>
        <dt class="text-muted">To</dt><dd class="col-span-2">{msg.audience}</dd>
        <dt class="text-muted">Delivered</dt><dd class="col-span-2 tabular">{msg.sent} of {(msg.total ?? 0) - (msg.skipped ?? 0)}{msg.failed ? `, ${msg.failed} failed` : ''}{msg.skipped ? `, ${msg.skipped} skipped` : ''}</dd>
        <dt class="text-muted">Sent by</dt><dd class="col-span-2">{msg.sentByName}</dd>
        <dt class="text-muted">Created</dt><dd class="col-span-2">{new Date(msg.createdAt).toLocaleString('en-PH', { timeZone: 'Asia/Manila' })}</dd>
      </dl>
      {attachments.length > 0 && (
        <div><p class="text-muted">Attachments</p>{attachments.map((a) => <a class="block text-primary-ink hover:underline" href={`/files/${a.id}`}>{a.filename}</a>)}</div>
      )}
      <div class="rounded-lg bg-surface-2 p-3"><p class="whitespace-pre-wrap">{msg.body}</p></div>
      {pending && <p class="text-xs text-muted">Emails go out in batches within the hourly limit set in Email Settings.</p>}
    </section>
    <section class="card overflow-hidden xl:col-span-2">
      <header class="flex flex-wrap items-center justify-between gap-2 p-4">
        <h2 class="text-sm font-semibold">Recipients</h2>
        <div class="flex gap-1 text-xs">
          {['', 'sent', 'queued', 'failed', 'skipped'].map((s) => (
            <a href={`/messages/${id}${s ? `?status=${s}` : ''}`} class:list={['rounded-md px-2 py-1', status === s ? 'bg-primary-soft text-primary-ink' : 'text-fg-2 hover:bg-surface-2']}>{s || 'all'}</a>
          ))}
        </div>
      </header>
      <div class="overflow-x-auto">
        <table class="table">
          <thead><tr><th>Name</th><th>Email</th><th>Status</th><th>Sent</th><th>Note</th></tr></thead>
          <tbody>
            {recipients.docs.map((r) => (
              <tr>
                <td class="font-medium">{r.name}</td>
                <td class="text-fg-2">{r.email ?? '—'}</td>
                <td><span class={tone[r.status] ?? 'badge-neutral'}>{r.status}</span></td>
                <td class="whitespace-nowrap tabular text-fg-2">{r.sentAt ? new Date(r.sentAt).toLocaleString('en-PH', { timeZone: 'Asia/Manila', timeStyle: 'short', dateStyle: 'short' }) : ''}</td>
                <td class="max-w-64 truncate text-xs text-fg-2" title={r.error ?? ''}>{r.error}{r.attempts ? ` (attempt ${r.attempts})` : ''}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <Pagination page={recipients.page ?? 1} totalPages={recipients.totalPages} totalDocs={recipients.totalDocs} limit={50} />
    </section>
  </div>
</App>
