---
import { startRegistration } from '@hr/cms/server/twofactor'

import Auth from '../layouts/Auth.astro'
import { clientIp, setChallengeCookie } from '../lib/auth'
import { toFormErrors } from '../lib/errors'

const MIN = 10
let errors: Record<string, string> = {}
let formError = ''
const values = { name: '', email: '' }
const { payload } = Astro.locals
const firstUser =
  (await payload.count({ collection: 'users', where: { and: [{ role: { equals: 'system-admin' } }, { emailVerified: { equals: true } }] }, overrideAccess: true })).totalDocs === 0
const restarted = Astro.url.searchParams.get('notice') === 'restart'

if (Astro.request.method === 'POST') {
  const fd = await Astro.request.formData()
  values.name = String(fd.get('name') ?? '').trim()
  values.email = String(fd.get('email') ?? '').trim().toLowerCase()
  const password = String(fd.get('password') ?? '')
  const confirm = String(fd.get('confirm') ?? '')
  if (!values.name) errors.name = 'Enter your full name'
  if (!values.email) errors.email = 'Enter your email'
  if (password.length < MIN) errors.password = `Use at least ${MIN} characters`
  else if (!/[A-Za-z]/.test(password) || !/\d/.test(password)) errors.password = 'Use both letters and numbers'
  if (password !== confirm) errors.confirm = 'Passwords do not match'
  if (!Object.keys(errors).length) {
    try {
      // Role and status cannot be chosen here: access rules force "HR Staff" / "pending".
      // The account only counts once the emailed code is entered (/register/verify).
      const res = await startRegistration(payload, { name: values.name, email: values.email, password }, clientIp(Astro.request))
      setChallengeCookie(Astro.cookies, res.challenge)
      return Astro.redirect('/register/verify')
    } catch (err) {
      const fe = toFormErrors(err)
      errors = fe.fields
      formError = /email/i.test(JSON.stringify(fe)) && !fe.fields.email ? 'That email is already registered.' : (fe.form ?? '')
      if (fe.fields.email) errors.email = 'That email is already registered or invalid.'
    }
  }
  Astro.response.status = 400
}
---
<Auth
  title={firstUser ? 'Create the System Admin account' : 'Request an HR account'}
  subtitle={firstUser
    ? 'No accounts exist yet. This first account will manage the system and approve other HR staff.'
    : 'A System Admin will review your request before you can sign in.'}
>
  {restarted && <p class="mb-4 rounded-lg bg-warning-soft px-3 py-2 text-sm text-warning" role="status">The verification code expired. Please submit the form again.</p>}
  {formError && <p class="mb-4 rounded-lg bg-danger-soft px-3 py-2 text-sm text-danger" role="alert">{formError}</p>}
  <form method="post" class="space-y-4" novalidate>
    <div>
      <label class="label" for="name">Full name</label>
      <input class="input" id="name" name="name" autocomplete="name" required value={values.name} aria-invalid={errors.name ? 'true' : undefined} />
      {errors.name && <p class="field-error">{errors.name}</p>}
    </div>
    <div>
      <label class="label" for="email">Work email</label>
      <input class="input" id="email" name="email" type="email" autocomplete="email" required value={values.email} aria-invalid={errors.email ? 'true' : undefined} />
      {errors.email && <p class="field-error">{errors.email}</p>}
    </div>
    <div>
      <label class="label" for="password">Password</label>
      <input class="input" id="password" name="password" type="password" autocomplete="new-password" required minlength={MIN} aria-invalid={errors.password ? 'true' : undefined} />
      {errors.password ? <p class="field-error">{errors.password}</p> : <p class="field-help">At least {MIN} characters, with letters and numbers.</p>}
    </div>
    <div>
      <label class="label" for="confirm">Confirm password</label>
      <input class="input" id="confirm" name="confirm" type="password" autocomplete="new-password" required aria-invalid={errors.confirm ? 'true' : undefined} />
      {errors.confirm && <p class="field-error">{errors.confirm}</p>}
    </div>
    <button class="btn-primary w-full">{firstUser ? 'Create account' : 'Submit request'}</button>
  </form>
  <Fragment slot="footer">Already have an account? <a href="/login" class="font-medium text-primary-ink hover:underline">Sign in</a></Fragment>
</Auth>
