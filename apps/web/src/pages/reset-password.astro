---
import Auth from '../layouts/Auth.astro'

const token = Astro.url.searchParams.get('token') ?? ''
let error = ''
if (Astro.request.method === 'POST') {
  const fd = await Astro.request.formData()
  const password = String(fd.get('password') ?? '')
  const confirm = String(fd.get('confirm') ?? '')
  const t = String(fd.get('token') ?? '')
  if (password !== confirm) error = 'Passwords do not match.'
  else {
    try {
      await Astro.locals.payload.resetPassword({ collection: 'users', data: { token: t, password }, overrideAccess: true })
      return Astro.redirect('/login?notice=reset')
    } catch (err) {
      const msg = (err as Error).message ?? ''
      error = /character|letters/i.test(msg) ? msg : 'This reset link is invalid or has expired. Request a new one.'
    }
  }
  Astro.response.status = 400
}
---
<Auth title="Choose a new password">
  {error && <p class="mb-4 rounded-lg bg-danger-soft px-3 py-2 text-sm text-danger" role="alert">{error}</p>}
  {
    token ? (
      <form method="post" class="space-y-4">
        <input type="hidden" name="token" value={token} />
        <div>
          <label class="label" for="password">New password</label>
          <input class="input" id="password" name="password" type="password" autocomplete="new-password" required minlength="10" />
          <p class="field-help">At least 10 characters, with letters and numbers.</p>
        </div>
        <div>
          <label class="label" for="confirm">Confirm new password</label>
          <input class="input" id="confirm" name="confirm" type="password" autocomplete="new-password" required />
        </div>
        <button class="btn-primary w-full">Update password</button>
      </form>
    ) : (
      <p class="text-sm text-muted">This page needs the link from your reset email.</p>
    )
  }
  <Fragment slot="footer"><a href="/login" class="font-medium text-primary-ink hover:underline">Back to sign in</a></Fragment>
</Auth>
