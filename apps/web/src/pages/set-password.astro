---
import { passwordLinkInfo, setPasswordWithLink } from '@hr/cms/server/accounts'

import Auth from '../layouts/Auth.astro'
import { errorMessage } from '../lib/errors'

const MIN = 10
const token = Astro.url.searchParams.get('token') ?? ''
const { payload } = Astro.locals
let error = ''

if (Astro.request.method === 'POST') {
  const fd = await Astro.request.formData()
  const password = String(fd.get('password') ?? '')
  const confirm = String(fd.get('confirm') ?? '')
  const t = String(fd.get('token') ?? '')
  if (password !== confirm) error = 'Passwords do not match.'
  else if (password.length < MIN || !/[A-Za-z]/.test(password) || !/\d/.test(password)) error = `Use at least ${MIN} characters with letters and numbers.`
  else {
    try {
      await setPasswordWithLink(payload, t, password)
      return Astro.redirect('/login?notice=password-set')
    } catch (err) {
      error = errorMessage(err)
    }
  }
  Astro.response.status = 400
}
const info = await passwordLinkInfo(payload, token)
---
<Auth title={info?.kind === 'invite' ? 'Welcome — choose your password' : 'Choose a new password'} subtitle={info ? `For ${info.name} (${info.maskedEmail})` : undefined}>
  {error && <p class="mb-4 rounded-lg bg-danger-soft px-3 py-2 text-sm text-danger" role="alert">{error}</p>}
  {
    info ? (
      <form method="post" class="space-y-4">
        <input type="hidden" name="token" value={token} />
        <div>
          <label class="label" for="password">New password</label>
          <input class="input" id="password" name="password" type="password" autocomplete="new-password" required minlength={MIN} />
          <p class="field-help">At least {MIN} characters, with letters and numbers.</p>
        </div>
        <div>
          <label class="label" for="confirm">Confirm password</label>
          <input class="input" id="confirm" name="confirm" type="password" autocomplete="new-password" required />
        </div>
        <button class="btn-primary w-full">Save password</button>
      </form>
    ) : (
      <p class="text-sm text-muted">This link is invalid, was already used or has expired. Ask your System Admin to send a new one, or use “Forgot password?” on the sign-in page.</p>
    )
  }
  <Fragment slot="footer"><a href="/login" class="font-medium text-primary-ink hover:underline">Back to sign in</a></Fragment>
</Auth>
