---
import { verifySmtp } from '@hr/cms/email/dbAdapter'
import { recordSmtp, sendNow } from '@hr/cms/server/mailer'
import { validateEmail } from '@hr/shared'

import App from '../../layouts/App.astro'
import { errorMessage, UserError } from '../../lib/errors'
import { setFlash } from '../../lib/flash'

const { payload, user } = Astro.locals
if (user?.role !== 'system-admin') return Astro.redirect('/?denied=1')

let error = ''
if (Astro.request.method === 'POST') {
  const fd = await Astro.request.formData()
  const action = String(fd.get('action'))
  try {
    if (action === 'save') {
      const port = Number(fd.get('port'))
      const security = String(fd.get('security'))
      const fromAddress = String(fd.get('fromAddress') ?? '').trim()
      const host = String(fd.get('host') ?? '').trim()
      if (!/^[a-z0-9.-]+$/i.test(host)) throw new UserError('Enter a valid host name, e.g. mail.example.com')
      if (!Number.isInteger(port) || port < 1 || port > 65535) throw new UserError('Enter a valid port (465 for SSL/TLS, 587 for STARTTLS).')
      if (!['ssl', 'starttls', 'none'].includes(security)) throw new UserError('Choose the connection security.')
      if (validateEmail(fromAddress) || !fromAddress) throw new UserError('Enter a valid From address.')
      await payload.updateGlobal({
        slug: 'smtp-settings',
        data: {
          host,
          port,
          security: security as never,
          username: String(fd.get('username') ?? '').trim(),
          password: String(fd.get('password') ?? ''),
          clearPassword: fd.get('clearPassword') === 'on',
          fromAddress,
          fromName: String(fd.get('fromName') ?? '').trim() || 'HR System',
        } as never,
        user,
        overrideAccess: false,
      })
      const check = await verifySmtp(payload)
      await recordSmtp(payload, check.ok ? null : `Could not connect: ${check.error}`)
      setFlash(Astro.cookies, check.ok
        ? { type: 'success', message: 'Saved. Connected and signed in to the email server successfully.' }
        : { type: 'error', message: `Saved, but connecting failed: ${check.error}` })
    } else if (action === 'test') {
      const to = String(fd.get('to') ?? '').trim()
      if (validateEmail(to) || !to) throw new UserError('Enter a valid address for the test email.')
      // This page is System-Admin-only, so the mail server's own error text is shown to help fix it.
      await sendNow(payload, to, 'Test email from the HR system', `This is a test email sent by ${user!.name}. Email sending works.`).catch((e: Error) => {
        throw new UserError(`Sending failed: ${e.message}`)
      })
      setFlash(Astro.cookies, { type: 'success', message: `Test email sent to ${to}.` })
    }
    return Astro.redirect('/settings/email-server')
  } catch (err) {
    error = errorMessage(err)
    Astro.response.status = 400
  }
}

const s = await payload.findGlobal({ slug: 'smtp-settings', user, overrideAccess: false })
const status = await payload.findGlobal({ slug: 'notification-settings', overrideAccess: true })
const fmt = (d?: string | null) => (d ? new Date(d).toLocaleString('en-PH', { timeZone: 'Asia/Manila' }) : 'never')
---
<App title="Email server" heading="Email server (SMTP)" description="Used for sign-in codes, invitations, password resets, payslips and all notifications. Stored in the database; the password is encrypted and never shown again." back={{ href: '/settings/notifications', label: 'Email settings' }}>
  {error && <div class="mb-4 rounded-lg bg-danger-soft px-4 py-3 text-sm text-danger" role="alert">{error}</div>}
  <div class="grid gap-6 xl:grid-cols-3">
    <form method="post" class="card grid gap-4 p-5 sm:grid-cols-2 xl:col-span-2" autocomplete="off" data-dirty-guard>
      <input type="hidden" name="action" value="save" />
      <div><label class="label" for="host">Host</label><input class="input" id="host" name="host" required value={s.host ?? ''} placeholder="mail.yourdomain.com" /></div>
      <div class="grid grid-cols-2 gap-3">
        <div><label class="label" for="port">Port</label><input class="input" id="port" name="port" type="number" min="1" max="65535" required value={s.port ?? 465} /></div>
        <div>
          <label class="label" for="security">Security</label>
          <select class="input" id="security" name="security">
            <option value="ssl" selected={(s.security ?? 'ssl') === 'ssl'}>SSL/TLS (SMTPS)</option>
            <option value="starttls" selected={s.security === 'starttls'}>STARTTLS</option>
            <option value="none" selected={s.security === 'none'}>None</option>
          </select>
        </div>
      </div>
      <div><label class="label" for="username">Username</label><input class="input" id="username" name="username" value={s.username ?? ''} autocomplete="off" /></div>
      <div>
        <label class="label" for="password">Password</label>
        <input class="input" id="password" name="password" type="password" autocomplete="new-password" placeholder={s.passwordSet ? '•••••••• (saved — leave blank to keep)' : 'Not set'} />
        {s.passwordSet && <label class="mt-1 flex items-center gap-2 text-xs text-muted"><input type="checkbox" name="clearPassword" class="size-3.5" /> Remove the saved password</label>}
      </div>
      <div><label class="label" for="fromAddress">From address</label><input class="input" id="fromAddress" name="fromAddress" type="email" required value={s.fromAddress ?? ''} placeholder="hr@yourdomain.com" /></div>
      <div><label class="label" for="fromName">From name</label><input class="input" id="fromName" name="fromName" value={s.fromName ?? 'HR System'} /></div>
      <div class="sm:col-span-2"><button class="btn-primary">Save and test connection</button></div>
    </form>
    <aside class="space-y-4">
      <section class="card space-y-2 p-5 text-sm">
        <h2 class="font-semibold">Status</h2>
        <p>Password: <strong>{s.passwordSet ? 'saved (encrypted)' : 'not set'}</strong></p>
        <p>Last successful send: {fmt(status.smtpLastOkAt)}</p>
        {status.smtpLastError && <p class="rounded-lg bg-danger-soft px-3 py-2 text-danger">Last error ({fmt(status.smtpLastErrorAt)}): {status.smtpLastError}</p>}
      </section>
      <form method="post" class="card space-y-2 p-5 text-sm">
        <input type="hidden" name="action" value="test" />
        <h2 class="font-semibold">Send a test email</h2>
        <input class="input" name="to" type="email" required value={user?.email} aria-label="Test recipient" />
        <button class="btn-secondary">Send test</button>
      </form>
    </aside>
  </div>
</App>
