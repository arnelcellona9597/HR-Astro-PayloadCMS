---
import { CONTEXT_MERGE_FIELDS, MERGE_FIELDS } from '@hr/shared'

import Icon from '../../../components/Icon.astro'
import App from '../../../layouts/App.astro'
import { errorMessage } from '../../../lib/errors'
import { setFlash } from '../../../lib/flash'

const CATEGORIES = ['Leave', 'Payroll', 'Announcement', 'Reminder', 'General', 'System']
const { payload, user } = Astro.locals
const isNew = Astro.params.id === 'new'
const doc = isNew ? null : await payload.findByID({ collection: 'email-templates', id: Number(Astro.params.id), depth: 0, user, overrideAccess: false, disableErrors: true })
if (!isNew && !doc) return new Response(null, { status: 404 })

let values = { name: doc?.name ?? '', category: doc?.category ?? 'Announcement', subject: doc?.subject ?? '', body: doc?.body ?? '' }
let error = ''
if (Astro.request.method === 'POST') {
  const fd = await Astro.request.formData()
  try {
    if (fd.get('action') === 'delete' && doc) {
      await payload.delete({ collection: 'email-templates', id: doc.id, user, overrideAccess: false })
      setFlash(Astro.cookies, { type: 'success', message: 'Template deleted.' })
      return Astro.redirect('/settings/notifications')
    }
    values = {
      name: String(fd.get('name') ?? '').trim(),
      category: String(fd.get('category') ?? 'General') as never,
      subject: String(fd.get('subject') ?? '').trim(),
      body: String(fd.get('body') ?? '').trim(),
    }
    const data = { ...values, category: values.category as never }
    if (doc) await payload.update({ collection: 'email-templates', id: doc.id, data, user, overrideAccess: false })
    else await payload.create({ collection: 'email-templates', data, user, overrideAccess: false })
    setFlash(Astro.cookies, { type: 'success', message: `Template "${values.name}" saved.` })
    return Astro.redirect('/settings/notifications')
  } catch (err) {
    error = errorMessage(err)
    Astro.response.status = 400
  }
}
const fields = doc?.key ? [...MERGE_FIELDS, ...CONTEXT_MERGE_FIELDS] : MERGE_FIELDS
---
<App title={isNew ? 'New template' : values.name} heading={isNew ? 'New email template' : `Template: ${doc!.name}`} back={{ href: '/settings/notifications', label: 'Email settings' }}>
  <Fragment slot="actions">
    {doc && !doc.key && (
      <form method="post" data-confirm="Delete this template?"><input type="hidden" name="action" value="delete" /><button class="btn-danger"><Icon name="trash" /> Delete</button></form>
    )}
  </Fragment>
  {error && <div class="mb-4 rounded-lg bg-danger-soft px-4 py-3 text-sm text-danger" role="alert">{error}</div>}
  {doc?.key && <p class="mb-4 rounded-lg bg-primary-soft px-4 py-3 text-sm text-primary-ink">This template is used for automatic emails ({doc.key}). You can change the wording; it can't be deleted.</p>}
  <div class="grid gap-6 xl:grid-cols-3">
    <form method="post" class="card space-y-4 p-5 xl:col-span-2" data-dirty-guard>
      <div class="grid gap-4 sm:grid-cols-2">
        <div><label class="label" for="name">Name</label><input class="input" id="name" name="name" required value={values.name} /></div>
        <div>
          <label class="label" for="category">Category</label>
          <select class="input" id="category" name="category">{CATEGORIES.map((c) => <option selected={c === values.category}>{c}</option>)}</select>
        </div>
      </div>
      <div><label class="label" for="subject">Subject</label><input class="input" id="subject" name="subject" required maxlength="200" value={values.subject} /></div>
      <div><label class="label" for="body">Message</label><textarea class="input min-h-72" id="body" name="body" required>{values.body}</textarea></div>
      <button class="btn-primary">Save template</button>
    </form>
    <aside class="card h-fit p-4 text-sm">
      <h2 class="mb-2 font-semibold">Placeholders</h2>
      <ul class="space-y-1">
        {fields.map((f) => <li><code class="font-mono text-xs">{`{{${f.name}}}`}</code> <span class="text-muted">— {f.description}</span></li>)}
      </ul>
    </aside>
  </div>
</App>
