---
import { inviteUser, issuePasswordLink } from '@hr/cms/server/accounts'
import { ROLE_LABELS, ROLES } from '@hr/shared/enums'

import Avatar from '../components/Avatar.astro'
import Icon from '../components/Icon.astro'
import App from '../layouts/App.astro'
import { toFormErrors, UserError } from '../lib/errors'
import { setFlash } from '../lib/flash'
import { relId, statusBadge } from '../lib/format'

const { payload, user } = Astro.locals
// Middleware already limits this page to System Admins; check again so every action is protected
// even if routing rules change.
if (user?.role !== 'system-admin') return Astro.redirect('/?denied=1')

const linkMessage = (who: string, r: { delivered: boolean; link: string }, what: string) =>
  r.delivered
    ? `${what} emailed to ${who}. The link works once and expires (invites: 24 hours, resets: 1 hour).`
    : `The email server isn't working, so nothing was sent. Give ${who} this single-use link privately: ${r.link}`

if (Astro.request.method === 'POST') {
  const fd = await Astro.request.formData()
  const id = Number(fd.get('id'))
  const action = String(fd.get('action'))
  try {
    if (action === 'add') {
      const role = String(fd.get('role'))
      if (!(ROLES as readonly string[]).includes(role)) throw new UserError('Choose a role.')
      const res = await inviteUser(payload, user as never, {
        name: String(fd.get('name') ?? ''),
        email: String(fd.get('email') ?? ''),
        role,
      })
      setFlash(Astro.cookies, { type: res.delivered ? 'success' : 'info', message: `Account created for ${res.user.name}. ${linkMessage(res.user.email, res, 'An invitation was')}` })
    } else if (!Number.isInteger(id) || id <= 0) {
      throw new UserError('Choose an account.')
    } else if (action === 'update') {
      const role = String(fd.get('role'))
      const status = String(fd.get('status'))
      if (!(ROLES as readonly string[]).includes(role) || !['approved', 'disabled'].includes(status)) throw new UserError('Invalid role or status')
      const doc = await payload.update({ collection: 'users', id, data: { role: role as never, status: status as never }, user, overrideAccess: false })
      setFlash(Astro.cookies, { type: 'success', message: `${doc.name} is now ${ROLE_LABELS[doc.role]} (${doc.status}).` })
    } else if (action === 'unlock') {
      const target = await payload.findByID({ collection: 'users', id, user, overrideAccess: false })
      await payload.unlock({ collection: 'users', data: { email: target.email } as never, overrideAccess: true, context: { trustedAuth: true } } as never)
      setFlash(Astro.cookies, { type: 'success', message: `${target.name} was unlocked.` })
    } else if (action === 'invite' || action === 'reset') {
      const target = await payload.findByID({ collection: 'users', id, user, overrideAccess: false })
      const res = await issuePasswordLink(payload, id, action)
      setFlash(Astro.cookies, { type: res.delivered ? 'success' : 'info', message: linkMessage(target.email, res, action === 'invite' ? 'A new invitation was' : 'A password reset link was') })
    } else if (action === 'delete') {
      await payload.delete({ collection: 'users', id, user, overrideAccess: false })
      setFlash(Astro.cookies, { type: 'success', message: 'Account deleted.' })
    }
  } catch (err) {
    const fe = toFormErrors(err)
    const msg = Object.values(fe.fields)[0] ?? fe.form ?? 'Could not update the account.'
    setFlash(Astro.cookies, { type: 'error', message: /unique|already/i.test(msg) ? 'That email address already has an account.' : msg })
  }
  return Astro.redirect('/users')
}

const users = await payload.find({ collection: 'users', sort: ['name'], limit: 500, depth: 0, user, overrideAccess: false, showHiddenFields: true })
const locked = (u: { lockUntil?: string | null }) => Boolean(u.lockUntil && new Date(u.lockUntil) > new Date())
---
<App title="HR Accounts" heading="HR accounts" description="Only System Admins can see this page. New accounts get an email invitation to choose their own password.">
  <section class="card mb-6 p-5">
    <h2 class="font-semibold">Add an HR account</h2>
    <form method="post" class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-4 lg:items-end">
      <input type="hidden" name="action" value="add" />
      <div><label class="label" for="n-name">Full name</label><input class="input" id="n-name" name="name" required maxlength="120" /></div>
      <div><label class="label" for="n-email">Email</label><input class="input" id="n-email" name="email" type="email" required maxlength="254" /></div>
      <div>
        <label class="label" for="n-role">Role</label>
        <select class="input" id="n-role" name="role">{ROLES.map((r) => <option value={r} selected={r === 'hr-staff'}>{ROLE_LABELS[r]}</option>)}</select>
      </div>
      <button class="btn-primary"><Icon name="send" /> Create & send invitation</button>
    </form>
  </section>

  <div class="card overflow-hidden">
    <div class="overflow-x-auto">
      <table class="table">
        <thead><tr><th>Name</th><th>Email</th><th>Role & status</th><th>Access</th><th></th></tr></thead>
        <tbody>
          {users.docs.map((u) => {
            const self = u.id === user?.id
            return (
              <tr>
                <td class="font-medium">
                  <div class="flex items-center gap-3">
                    <Avatar name={u.name} imageId={relId(u.avatar)} class="size-8 text-xs" />
                    <div class="min-w-0">
                      {u.name}{self && <span class="ml-2 badge-primary">You</span>}
                      {!u.emailVerified && <span class="ml-2 badge-warning" title="Hasn't set a password / signed in yet">Invitation pending</span>}
                    </div>
                  </div>
                </td>
                <td class="text-fg-2">{u.email}</td>
                <td>
                  <form method="post" class="flex flex-wrap items-center gap-2">
                    <input type="hidden" name="id" value={u.id} />
                    <input type="hidden" name="action" value="update" />
                    <select class="input w-auto py-1.5" name="role" aria-label={`Role for ${u.name}`}>
                      {ROLES.map((r) => <option value={r} selected={u.role === r}>{ROLE_LABELS[r]}</option>)}
                    </select>
                    <select class="input w-auto py-1.5" name="status" aria-label={`Status for ${u.name}`}>
                      {['approved', 'disabled'].map((s) => <option value={s} selected={u.status === s}>{s === 'approved' ? 'active' : 'disabled'}</option>)}
                    </select>
                    <button class="btn-secondary btn-sm">Save</button>
                    <span class={statusBadge(u.status)}>{u.status === 'approved' ? 'active' : u.status}</span>
                  </form>
                </td>
                <td>
                  <div class="flex flex-wrap items-center gap-2">
                    {locked(u) && (
                      <form method="post"><input type="hidden" name="id" value={u.id} /><input type="hidden" name="action" value="unlock" /><button class="btn-secondary btn-sm">Unlock</button></form>
                    )}
                    {!u.emailVerified ? (
                      <form method="post"><input type="hidden" name="id" value={u.id} /><input type="hidden" name="action" value="invite" /><button class="btn-ghost btn-sm">Resend invitation</button></form>
                    ) : (
                      !self && (
                        <form method="post" data-confirm={`Email ${u.name} a link to choose a new password?`}>
                          <input type="hidden" name="id" value={u.id} />
                          <input type="hidden" name="action" value="reset" />
                          <button class="btn-ghost btn-sm">Send password reset</button>
                        </form>
                      )
                    )}
                  </div>
                </td>
                <td class="text-right">
                  {!self && (
                    <form method="post" data-confirm={`Delete the account of ${u.name}? Disabling keeps their history linked; deleting removes the login.`}>
                      <input type="hidden" name="id" value={u.id} />
                      <input type="hidden" name="action" value="delete" />
                      <button class="btn-ghost btn-sm text-danger">Delete</button>
                    </form>
                  )}
                </td>
              </tr>
            )
          })}
        </tbody>
      </table>
    </div>
  </div>
  <div class="mt-4 grid gap-3 text-sm text-fg-2 md:grid-cols-2">
    <p class="card p-4"><strong class="text-fg">System Admin</strong> — everything HR Staff can do, plus adding, disabling and deleting HR accounts and the email server settings.</p>
    <p class="card p-4"><strong class="text-fg">HR Staff</strong> — every HR feature: records, deleting, imports, payroll, messages, settings and the audit log. Cannot manage HR accounts.</p>
  </div>
</App>
